tainer images, referenced by digest&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;DA06&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;SBOMs, scan results, signed attestations&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;DA07&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Pipeline secrets in Secret Vault&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;DA08&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Site desired state (Git): K8s manifests, Quadlet units&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;DA09&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;CI/CD, deployment and host audit logs&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;DA10&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Quadlet units and host config (/etc/containers)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;DA11&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;policy.json and registries.conf (Podman)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;DA12&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Site trust bundle and revocation list&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=fill;verticalAlign=top;align=left;fillColor=#FFFFFF;strokeColor=#999999;shadow=1;" vertex="1" parent="1"><mxGeometry x="540" y="1260" width="300" height="318" as="geometry"/></mxCell><mxCell id="c181" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:9px&quot;&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;background:#D5E8D4;color:#000000;text-align:center;border:1px solid #999;padding:3px&quot;&gt;&lt;b&gt;Security Controls&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#D5E8D4;color:#000000&quot;&gt;&lt;td style=&quot;border:1px solid #999;padding:2px;width:40px&quot;&gt;&lt;b&gt;ID&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px;width:350px&quot;&gt;&lt;b&gt;Description&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C01&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Phishing-resistant MFA, no long-lived PATs&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C02&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Branch protection, signed commits, CODEOWNERS, 4-eyes&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C03&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Short-lived OIDC workload identity&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C04&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;SAST/SCA/image scan as blocking gates&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C05&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Dependency proxy, pinning by version/digest&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C06&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Ephemeral rootless build agents, no docker.sock&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C07&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Central versioned pipeline templates&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C08&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Dynamic least-privilege secrets (Vault)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C09&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Signing in KMS/HSM after all gates&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C10&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Signed SBOM/scan attestations bound to digest&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C11&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Two-person IT→OT promotion gate tied to change ID&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C12&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;K8s admission control: signature + Pod Security restricted, fail-closed&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C13&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;K8s namespace-scoped GitOps controller, deploy by digest&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C14&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Default-deny network policy / host firewall, egress allow-list to OT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C15&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Central immutable logging to SIEM&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C16&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Continuous re-scan and release revocation&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C17&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;SoD, JIT admin access, access reviews&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C18&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;HA/backup for SCM/CI, break-glass path&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C19&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Signed desired state: verify commit before apply (both runtimes)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C20&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Podman policy.json default-reject; signed images from site mirror only; tested&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C21&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Rootless Podman, no podman.socket, no privileged containers&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C22&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;SELinux enforcing, per-container :Z labels&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C23&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Digest-only image refs, no AutoUpdate on tags&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C24&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Root-owned Quadlet dir, drift repair and file-integrity alerts&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C25&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Site trust bundle: expiry, revocation sync, staleness alerts&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C26&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Loca
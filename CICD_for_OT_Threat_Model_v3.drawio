er:1px solid #bbb;padding:2px&quot;&gt;C32 C14&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Both&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;AV33&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;CI run history and status checks; controller / agent status&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;T01&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;T R&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;R-037, R-019&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C33 C15&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Both&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;AV34&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Approval evidence view&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;T01&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;S T&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;R-039&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C35 C10&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Both&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;AV35&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;OT SSO / IdP&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;T01&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;D&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;R-040&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C37 C26&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Both&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;–&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Governance gap (no AV)&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;–&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;–&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;R-030&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C27&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Both&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">

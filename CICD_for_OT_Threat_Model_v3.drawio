        <mxCell id="c219" parent="1" style="text;html=1;whiteSpace=wrap;overflow=fill;verticalAlign=top;align=left;fillColor=#FFFFFF;strokeColor=#999999;shadow=1;" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:9px&quot;&gt;&lt;tr&gt;&lt;td colspan=&quot;5&quot; style=&quot;background:#F8CECC;color:#000000;text-align:center;border:1px solid #999;padding:3px&quot;&gt;&lt;b&gt;FOTIS critical OT attack path → break points (independent of a poisoned pipeline: hop 5, partly 3, 4 and 7)&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F8CECC;color:#000000&quot;&gt;&lt;td style=&quot;border:1px solid #999;padding:2px;width:35px&quot;&gt;&lt;b&gt;Hop&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px;width:140px&quot;&gt;&lt;b&gt;Attack step&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px;width:150px&quot;&gt;&lt;b&gt;Risks&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px;width:480px&quot;&gt;&lt;b&gt;Where we break it&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px;width:95px&quot;&gt;&lt;b&gt;Independent?&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Pipeline poisoning&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;R-007, R-002&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C02 C07: CODEOWNERS, central templates, PR builds without secrets&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;No&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;2&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Runner compromise&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;R-008, R-034&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C06 C30: ephemeral, dedicated release runners, no route to OT&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;No&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;3&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Credential theft&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;R-009, R-012, R-035, R-038&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C03 C08 C09 C31 C34: OIDC, dynamic secrets, KMS signing key, approver key behind SSO step-up&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Partly&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;4&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Malicious signed image&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;R-012, R-013, R-021, R-038, R-039&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C10 C11 C36 C19 C35: provenance, IT gate, Trusted Registries gate, OT approval with verified diff. Signatures alone do not stop a poisoned pipeline&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Partly&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;5&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Privileged container deployment&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;R-016, R-024, R-025, R-031, R-036&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C12 C20 C21 C38: admission and Podman agent Quadlet policy from configuration management, enforced even for signed, approved releases&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Yes&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;6&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Host escape&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;R-016, R-025, R-026&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C21 C22: rootless, SELinux, no sockets; exploit detection is runtime security&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Yes&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;7&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Lateral movement into OT&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;R-018, R-036, R-008&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C14 C32: admission default-deny check + OT firewall (network team); bundle NetworkPolicy alone is not independent&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Partly&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;8&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Process disruption&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;R-029, R-017, R-028&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C26 C28 C16: rollback, cached release, deny-list; OT process impact out of scope&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Recovery&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="310" width="900" x="1330" y="2320" as="geometry" />

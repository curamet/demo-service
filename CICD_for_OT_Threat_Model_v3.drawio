        <mxCell id="c214" parent="1" style="text;html=1;whiteSpace=wrap;overflow=fill;verticalAlign=top;align=left;fillColor=#FFFFFF;strokeColor=#999999;shadow=1;" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:9px&quot;&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;background:#FFF2CC;color:#000000;text-align:center;border:1px solid #999;padding:3px&quot;&gt;&lt;b&gt;Data Assets&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#FFF2CC;color:#000000&quot;&gt;&lt;td style=&quot;border:1px solid #999;padding:2px;width:40px&quot;&gt;&lt;b&gt;ID&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px;width:250px&quot;&gt;&lt;b&gt;Description&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;DA01&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Application source code and Dockerfiles&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;DA02&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;CI pipeline definitions and shared templates&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;DA03&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;SCM, CI, registry and deploy tokens&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;DA04&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Image signing keys (KMS/HSM)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;DA05&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Container images, referenced by digest&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;DA06&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;SBOMs, scan results, signed attestations&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;DA07&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Pipeline secrets in Secret Vault&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;DA08&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Site release bundles (K8s manifests / chart, Quadlet units) and site-approval attestations&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;DA13&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Site approval signing key (one per site)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;DA14&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Approver SSO identities and sessions&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;DA09&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;CI/CD, deployment and host audit logs&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;DA10&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Quadlet units and host config (/etc/containers)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;DA11&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;policy.json and registries.conf (Podman)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;DA12&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Runtime verification policy: trusted signers, deny-list&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="362" width="300" x="540" y="1260" as="geometry" />
        </mxCell>
        <mxCell id="c215" parent="1" style="text;html=1;whiteSpace=wrap;overflow=fill;verticalAlign=top;align=left;fillColor=#FFFFFF;strokeColor=#999999;shadow=1;" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:9px&quot;&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;background:#D5E8D4;color:#000000;text-align:center;border:1px solid #999;padding:3px&quot;&gt;&lt;b&gt;Security Controls&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#D5E8D4;color:#000000&quot;&gt;&lt;td style=&quot;border:1px solid #999;padding:2px;width:40px&quot;&gt;&lt;b&gt;ID&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px;width:350px&quot;&gt;&lt;b&gt;Description&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C01&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Phishing-resistant MFA, no long-lived PATs&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C02&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Branch protection, signed commits, CODEOWNERS, 4-eyes&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C03&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Short-lived OIDC workload identity&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C04&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;SAST/SCA/image scan as blocking gates&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C05&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Dependency proxy, pinning by version/digest&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C06&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Ephemeral rootless build agents, no docker.sock&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C07&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Central versioned pipeline templates&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C08&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Dynamic least-privilege secrets (Vault)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C09&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Signing in KMS/HSM after all gates&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C10&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Signed SBOM, scan and provenance attestations bound to digest&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C11&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Two-person IT→OT promotion gate tied to change ID&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C12&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;K8s admission control: signature + provenance + Pod Security restricted, fail-closed&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C13&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;K8s namespace-scoped GitOps controller, deploy by digest&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C14&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Default-deny network policy / host firewall, egress allow-list to OT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C15&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Audit events emitted and retained at source; exported to SIEM (external)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C16&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Continuous re-scan and release revocation&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C17&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;SoD, JIT admin access, access reviews&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C18&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;HA/backup for SCM/CI, break-glass path&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C19&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Controller and agent verify the bundle with this site&#39;s approval key only; forward-only versions; fail-closed&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C20&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Podman policy.json default-reject; signed images from site registry only; tested&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C21&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Rootless Podman, no podman.socket, no privileged containers&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C22&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;SELinux enforcing, per-container :Z labels&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C23&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Digest-only image refs, no AutoUpdate on tags&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C24&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Root-owned Quadlet dir, drift repair and file-integrity alerts&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C25&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Runtime verification policy via configuration management (not the registry): rotation, deny-list, staleness alerts&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C26&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Local rollback: previous release cached on node or host, standby host&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C27&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Runtime baseline conformance checks for both profiles&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C28&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Current + previous release cached on every node and host (registry HA: Trusted Registries)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C29&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Approved repo per site writable only by the Site Approval Service; read-only runtime accounts&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C30&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Dedicated release runners, no shared caches, environment-bound OIDC identities&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C31&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Least-privilege CI and deploy identities: no exec, no secret read, no token automount&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C32&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;NetworkPolicy / host firewall in signed bundle: default-deny, egress allow-list, policy-as-code tests, OT-security approval&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C33&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;CI run history and logs retained, status checks from trusted CI identity only; deployment status verified against approved repo&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C34&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Site Approval Service: SSO, phishing-resistant MFA, step-up on approve, non-exportable site key (HSM/TPM), built via golden path&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C35&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Approval view shows only evidence verified from signatures and attestations; auto-block wrong site scope&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C36&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Signed site-scope attestation from CI, enforced by Trusted Registries at promotion and replication&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C37&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;OT-resilient SSO (OT-resident IdP or federation), break-glass approver, pre-approved emergency rollback&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;C38&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Podman agent enforces Quadlet policy before apply (no Privileged, host network, socket or broad mounts)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="890" width="400" x="870" y="1260" as="geometry" />
        </mxCell>
        <mxCell id="c216" parent="1" style="text;html=1;whiteSpace=wrap;overflow=fill;verticalAlign=top;align=left;fillColor=#FFFFFF;strokeColor=#999999;shadow=1;" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:9px&quot;&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;background:#F8CECC;color:#000000;text-align:center;border:1px solid #999;padding:3px&quot;&gt;&lt;b&gt;Threat Agents&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F8CECC;color:#000000&quot;&gt;&lt;td style=&quot;border:1px solid #999;padding:2px;width:40px&quot;&gt;&lt;b&gt;ID&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px;width:280px&quot;&gt;&lt;b&gt;Description&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;T01&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Unauthorized user&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;T02&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Authorized user (insider: operations, local admin, release manager)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;T03&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Developer (unintentional)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;T04&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Compromised supplier / upstream package&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="142" width="330" x="1300" y="1260" as="geometry" />
        </mxCell>
        <mxCell id="c217" parent="1" style="text;html=1;whiteSpace=wrap;overflow=fill;verticalAlign=top;align=left;fillColor=#FFFFFF;strokeColor=#999999;shadow=1;" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:9px&quot;&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;background:#4A7CC9;color:#FFFFFF;text-align:center;border:1px solid #999;padding:3px&quot;&gt;&lt;b&gt;Threat Model completion checklist&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#4A7CC9;color:#FFFFFF&quot;&gt;&lt;td style=&quot;border:1px solid #999;padding:2px;width:420px&quot;&gt;&lt;b&gt;Check&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px;width:140px&quot;&gt;&lt;b&gt;Status (X if completed)&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Main components of System under Consideration (SuC)&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;X&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Main actors&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;X&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Connection / Communication arrows for each component - and communication protocols&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Partial: add protocols&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Trust boundaries&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;X&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Relevant assets (Data, Software, ..) - assets that could be of interest of an attacker&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;X&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Relevant security controls (How are we protecting the assets)&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;X&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Threat Agents (Who could attack our system, intentionally or unintentionally)&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;X&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Attack Vectors (What kind of attacks?)&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;X&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Both runtime profiles modelled (Kubernetes, Podman)&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;X&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Out-of-scope items recorded (registry, runtime security, OT assets, network infrastructure)&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;X&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Ownership decisions recorded (site registry: Trusted Registries; SIEM external; one OT approver)&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;X&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;FOTIS feedback traced (risk assessment: FOTIS Feedback Trace tab)&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;X&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;Traceability Matrix (not in this file)&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px&quot;&gt;See risk assessment: Diagram reference&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">

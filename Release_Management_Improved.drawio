        <mxCell id="ed13" value="read immutable manifest" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;fontSize=10;strokeColor=#5A6470;" edge="1" parent="1" source="c2" target="d2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ed14" value="approved release" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;strokeColor=#5A6470;strokeWidth=2;" edge="1" parent="1" source="c5" target="d3">
          <mxGeometry relative="1" as="geometry" />

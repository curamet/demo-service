        <mxCell id="subtitle" value="Immutable product composition  ·  atomic site-branch deployment  ·  GitOps reconciliation  ·  release observability" style="text;html=1;fontSize=14;fontStyle=2;align=left;fontColor=#5A6470;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1400" height="26" as="geometry" />

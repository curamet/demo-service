        <!-- ═══ FOOTER ═══ -->
        <mxCell id="principles" value="DESIGN PRINCIPLES   ·   Git is the authoritative release history   ·   Product releases are immutable and environment-independent   ·   Images are pinned by digest   ·   Site branches declare desired state and are protected   ·   All application updates are atomic per deployment   ·   One deployment targets one site   ·   ArgoCD is the only actor with cluster credentials   ·   Prometheus holds current operational state, not release history" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1F3A68;strokeColor=#1F3A68;fontSize=13;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=18;verticalAlign=middle;" vertex="1" parent="1">

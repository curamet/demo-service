          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ed12" value="approve exact release" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;strokeColor=#5A6470;" edge="1" parent="1" source="c4" target="c5">
          <mxGeometry relative="1" as="geometry" />

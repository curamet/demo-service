<mxfile host="app.diagrams.net"><diagram id="ot-ref-v2" name="Generic reference pattern v2"><mxGraphModel dx="1700" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1120" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v2" value="&lt;b&gt;Generic CI/CD End-to-End Reference Pattern for OT · v2&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Central preparation • governed transfer • OT-controlled execution on Kubernetes or Podman&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#0B1F3A;strokeColor=none;fontColor=#FFFFFF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1620" height="60" as="geometry"/></mxCell><mxCell id="v3" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F4F8FD;strokeColor=#6C8EBF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="520" height="800" as="geometry"/></mxCell><mxCell id="v4" value="&lt;b&gt;1. CENTRAL PREPARATION&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;Defines and prepares what may be deployed&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F8FD;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="520" height="50" as="geometry"/></mxCell><mxCell id="v5" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFCF0;strokeColor=#D6B656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="580" y="100" width="300" height="800" as="geometry"/></mxCell><mxCell id="v6" value="&lt;b&gt;2. GOVERNED TRANSFER BOUNDARY&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;Validates, stages and keeps approved release inputs trustworthy&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFCF0;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="580" y="100" width="300" height="50" as="geometry"/></mxCell><mxCell id="v7" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FDF5F5;strokeColor=#B85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="900" y="100" width="760" height="800" as="geometry"/></mxCell><mxCell id="v8" value="&lt;b&gt;3. FACTORY / SITE EXECUTION&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;Controls when, where and how change executes, per runtime profile&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDF5F5;strokeColor=#B85450;fontSize=13;" vertex="1" parent="1"><mxGeometry x="900" y="100" width="760" height="50" as="geometry"/></mxCell><mxCell id="v9" value="&lt;b&gt;Source &amp;amp; Change&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;App code, deployment definitions for both runtime profiles (Helm/Kustomize + Quadlet), review and history&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="170" width="200" height="90" as="geometry"/></mxCell><mxCell id="v10" value="&lt;b&gt;Build &amp;amp; Verify&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;Golden-path pipeline template; ephemeral build, test, SAST/SCA, image scan, SBOM&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="170" width="200" height="90" as="geometry"/></mxCell><mxCell id="v11" value="&lt;b&gt;Sign &amp;amp; Attest&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;Sign image digest; provenance, SBOM and scan results as signed attestations&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="320" width="200" height="90" as="geometry"/></mxCell><mxCell id="v12" value="&lt;b&gt;Release Package&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;Signed release bundle: image digests + rendered K8s manifests / chart + Quadlet units + evidence&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="320" width="200" height="90" as="geometry"/></mxCell><mxCell id="v13" value="&lt;b&gt;Central Release Store&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;Approved release inputs ready for transfer&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="470" width="200" height="90" as="geometry"/></mxCell><mxCell id="v14" value="&lt;b&gt;Release Approval&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;Two-person promotion gate tied to change ID&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="470" width="200" height="90" as="geometry"/></mxCell><mxCell id="v15" value="&lt;b&gt;Central rule&lt;/b&gt;&lt;br&gt;No direct deployment or administrative access to OT. The same signed artifact serves every runtime target." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#F5F5F5;strokeColor=#999999;fontSize=9;" vertex="1" parent="1"><mxGeometry x="70" y="790" width="460" height="90" as="geometry"/></mxCell><mxCell id="v16" value="IT" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=none;fontColor=#FFFFFF;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="850" width="34" height="34" as="geometry"/></mxCell><mxCell id="v17" value="&lt;b&gt;Continuous Re-scan&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;New CVEs checked against stored SBOMs; raises revocation&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="600" y="180" width="260" height="90" as="geometry"/></mxCell><mxCell id="v18" value="&lt;b&gt;Trusted Registries project capability&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;Governed handoff of approved digests and deploy bundles; signature and policy re-verified on promotion&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="600" y="350" width="260" height="100" as="geometry"/></mxCell><mxCell id="v19" value="&lt;b&gt;Trust Bundle &amp;amp; Revocation&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;Public keys, revoked digests and policy versions for site verification&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="600" y="520" width="260" height="90" as="geometry"/></mxCell><mxCell id="v20" value="&lt;b&gt;Boundary rule&lt;/b&gt;&lt;br&gt;Expose approved releases without becoming a central execution authority." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#F5F5F5;strokeColor=#999999;fontSize=9;" vertex="1" parent="1"><mxGeometry x="600" y="790" width="260" height="90" as="geometry"/></mxCell><mxCell id="v21" value="&lt;b&gt;Activation Record&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:8px'&gt;Signed pin of the approved bundle digest (sequence + expiry); OCI repo, write: OT approver only&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=9;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="930" y="170" width="160" height="100" as="geometry"/></mxCell><mxCell id="v22" value="&lt;b&gt;Site OCI Registry&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:8px'&gt;One store: images, charts / manifests, Quadlet bundles, attestations; previous release kept for rollback&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=9;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1110" y="170" width="160" height="100" as="geometry"/></mxCell><mxCell id="v23" value="&lt;b&gt;Site Trust Bundle&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:8px'&gt;Keys and revocation list used by both runtimes&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=9;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1290" y="170" width="160" height="100" as="geometry"/></mxCell><mxCell id="v24" value="&lt;b&gt;OT Deployment Authority&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:8px'&gt;Approve, activate, stop and roll back&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=9;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1470" y="170" width="160" height="100" as="geometry"/></mxCell><mxCell id="v25" value="&lt;b&gt;Runtime profile A · Kubernetes&lt;/b&gt; &lt;font style='font-size:9px'&gt;(several apps, HA, site cluster)&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B85450;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="930" y="300" width="700" height="165" as="geometry"/></mxCell><mxCell id="v26" value="&lt;b&gt;GitOps Controller&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:8px'&gt;Flux / Argo CD (OCI source): verify and pull bundle, apply, detect drift; namespace-scoped&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=9;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="950" y="340" width="190" height="100" as="geometry"/></mxCell><mxCell id="v27" value="&lt;b&gt;Admission Control&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:8px'&gt;Verify signature + attestations, reject revoked digests; Pod Security restricted&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=9;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1180" y="340" width="190" height="100" as="geometry"/></mxCell><mxCell id="v28" value="&lt;b&gt;K8s Workloads&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:8px'&gt;Namespaced pods, default-deny NetworkPolicy, egress allow-list to OT, quotas&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=9;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1410" y="340" width="200" height="100" as="geometry"/></mxCell><mxCell id="v29" value="&lt;b&gt;Runtime profile B · Podman&lt;/b&gt; &lt;font style='font-size:9px'&gt;(single edge or line host, no cluster)&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B85450;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="930" y="480" width="700" height="165" as="geometry"/></mxCell><mxCell id="v30" value="&lt;b&gt;Host Deploy Agent&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:8px'&gt;systemd timer + custom agent: verify and pull bundle, apply, report state&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=9;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="950" y="520" width="190" height="100" as="geometry"/></mxCell><mxCell id="v31" value="&lt;b&gt;Pull Policy&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:8px'&gt;policy.json: signed images only, from site mirror only; SELinux enforcing&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=9;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1180" y="520" width="190" height="100" as="geometry"/></mxCell><mxCell id="v32" value="&lt;b&gt;Podman Workloads&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:8px'&gt;Rootless containers via Quadlet (systemd); digest-pinned refs from signed bundles; no AutoUpdate on tags&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=9;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1410" y="520" width="200" height="100" as="geometry"/></mxCell><mxCell id="v33" value="&lt;b&gt;Runtime selection&lt;/b&gt;&lt;br&gt;Kubernetes: several apps, HA, site-level policy.&lt;br&gt;Podman: one host, small footprint, no cluster to operate." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#F5F5F5;strokeColor=#999999;fontSize=9;" vertex="1" parent="1"><mxGeometry x="930" y="790" width="200" height="90" as="geometry"/></mxCell><mxCell id="v34" value="&lt;b&gt;Local Operations &amp;amp; Recovery&lt;/b&gt;&lt;br&gt;Status, audit, rollback and recovery for both runtimes without central availability. Logs to site SIEM; optional OT-initiated status export to central." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#F5F5F5;strokeColor=#999999;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1150" y="790" width="480" height="90" as="geometry"/></mxCell><mxCell id="v35" value="OT" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="910" y="850" width="34" height="34" as="geometry"/></mxCell><mxCell id="e36" value="1. Approved change" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#1F1F1F;fontSize=9;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v9" target="v10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e37" value="2. Verified output" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#1F1F1F;fontSize=9;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v10" target="v11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e38" value="3. Signed digest + attestations" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#1F1F1F;fontSize=9;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v11" target="v12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e39" value="4. Publish release" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#1F1F1F;fontSize=9;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v12" target="v13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e40" value="5. Approve promotion" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#1F1F1F;fontSize=9;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v14" target="v13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e41" value="6. Governed transfer (approved digests only)" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#1F1F1F;fontSize=9;fontStyle=1;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=8 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v13" target="v18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="170" y="600"/><mxPoint x="560" y="600"/><mxPoint x="560" y="400"/></Array></mxGeometry></mxCell><mxCell id="e42" value="re-scan SBOMs" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#1F1F1F;fontSize=9;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v17" target="v18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e43" value="revoke" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#1F1F1F;fontSize=9;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v17" target="v19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="870" y="225"/><mxPoint x="870" y="565"/></Array></mxGeometry></mxCell><mxCell id="e44" value="7. Site pulls images + release bundles (OT-initiated)" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#1F1F1F;fontSize=9;fontStyle=1;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=8 4;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="v18" target="v22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="890" y="420"/><mxPoint x="890" y="285"/><mxPoint x="1190" y="285"/></Array></mxGeometry></mxCell><mxCell id="e45" value="8. Sync trust bundle + revocations" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#1F1F1F;fontSize=9;fontStyle=1;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=8 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="v19" target="v23"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="730" y="655"/><mxPoint x="1645" y="655"/><mxPoint x="1645" y="280"/><mxPoint x="1418" y="280"/></Array></mxGeometry></mxCell><mxCell id="e46" value="9. Approve &amp;amp; sign activation record" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#8E2A2A;fontSize=9;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v24" target="v21"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1550" y="150"/><mxPoint x="1010" y="150"/></Array></mxGeometry></mxCell><mxCell id="e47" value="10a. Pull activation → bundle" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#1F1F1F;fontSize=9;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.4;exitY=1;exitDx=0;exitDy=0;entryX=0.23;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v21" target="v26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e48" value="10b. Pull activation + Quadlet bundle" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#1F1F1F;fontSize=9;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v21" target="v30"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="918" y="240"/><mxPoint x="918" y="570"/></Array></mxGeometry></mxCell><mxCell id="e49" value="create" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#1F1F1F;fontSize=9;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v26" target="v27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e50" value="admit if verified" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#1F1F1F;fontSize=9;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v27" target="v28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e51" value="pull by digest" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#1F1F1F;fontSize=9;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v30" target="v31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e52" value="run if signed" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#1F1F1F;fontSize=9;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v31" target="v32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e53" value="image pull" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#1F1F1F;fontSize=9;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.6;exitY=1;exitDx=0;exitDy=0;entryX=0.15;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v22" target="v27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e54" value="image pull" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#1F1F1F;fontSize=9;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.875;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v22" target="v31"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1250" y="290"/><mxPoint x="1390" y="290"/><mxPoint x="1390" y="505"/><mxPoint x="1320" y="505"/></Array></mxGeometry></mxCell><mxCell id="e55" value="verify keys" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#1F1F1F;fontSize=9;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.4;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v23" target="v27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e56" value="11. Status, audit, rollback" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#8E2A2A;fontSize=9;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v32" target="v34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v57" value="&lt;b&gt;Required properties&lt;/b&gt;&lt;br&gt;Immutable, signed and traceable releases • One artifact for every runtime • Independent verification at site (admission control / policy.json) • OT-initiated pull • Site-bounded execution • Least privilege, rootless where possible • Local approval and rollback • No dependency on central CI for normal operation" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E2EFD9;strokeColor=#82B366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="920" width="1620" height="58" as="geometry"/></mxCell><mxCell id="v58" value="&lt;b&gt;Cross-cutting capabilities&lt;/b&gt;&lt;br&gt;Identity &amp;amp; access • Security policy • Traceability &amp;amp; evidence • Observability • Vulnerability response &amp;amp; revocation • Trust-root lifecycle • Ownership &amp;amp; support • Exception management" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="988" width="1620" height="50" as="geometry"/></mxCell><mxCell id="v59" value="&lt;b&gt;Acceptance principle:&lt;/b&gt; Central capabilities prepare and coordinate change; all OT-changing execution remains OT-governed and site-bounded, whichever runtime the site uses." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#0B1F3A;strokeColor=none;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1048" width="1620" height="42" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>